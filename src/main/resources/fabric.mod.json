  "authors": ["tr7zw"],
  "contact": {
    "homepage": "https://modrinth.com/mod/entityculling",
    "sources": "https://github.com/tr7zw/EntityCulling"
  },
  "license": "MIT",
  "icon": "assets/entityculling/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.hitboxexpand.HitboxExpandMod"
    ],
    "modmenu": [
      "com.hitboxexpand.ModMenuIntegration"
    ]
  },
  "mixins": [
    "entityculling.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21.4",
    "java": ">=21",
    "fabric-api": "*"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.discord": "https://discord.gg/entityculling"
